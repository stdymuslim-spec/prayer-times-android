<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: black background, centred content that drifts a little to avoid burn-in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#000000">

  <LinearLayout
    android:id="@+id/dream_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
      android:id="@+id/dream_gregorian"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#C9D6CE"
      android:textSize="22sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/dream_hijri"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#6FD6B0"
      android:textSize="18sp" />

    <TextView
      android:id="@+id/dream_event"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textColor="#F2C46D"
      android:textSize="20sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextClock
      android:id="@+id/dream_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="75dp"
      android:fontFamily="sans-serif-thin"
      android:format12Hour="HH:mm"
      android:format24Hour="HH:mm"
      android:includeFontPadding="false"
      android:textColor="#E8EEEA"
      android:textSize="120sp" />

    <TextView
      android:id="@+id/dream_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="#8FA398"
      android:textSize="20sp" />
  </LinearLayout>
</FrameLayout>
